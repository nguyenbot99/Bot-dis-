# Cấu hình bot Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here
GUILD_ID=your_guild_id_here   # Tùy chọn: đăng ký lệnh nhanh hơn trong một máy chủ

# Tùy chọn TTS
# ESPEAK_CMD=espeak-ng   # Lệnh espeak-ng nếu có sẵn trên hệ thống
TTS_DEFAULT_LANG=vi
TTS_INTERRUPT=true
TTS_VOLUME=100
TTS_MAX_TIME_MS=60000
